# Remote lists are kept, but OpenClash stores them in ./rule_provider/.
rule-providers:
  applications:
    type: http
    behavior: classical
    format: text
    interval: 86400
    url: 'https://fastly.jsdelivr.net/gh/DustinWin/ruleset_geodata@clash-ruleset/applications.list'
    path: './rule_provider/applications.list'
  lipiston:
    type: file
    behavior: classical
    format: yaml
    path: './rule_provider/lipiston.yaml'
  ai:
    type: http
    behavior: classical
    format: text
    interval: 86400
    url: 'https://github.com/dahaha-365/YaNet/raw/refs/heads/dist/rulesets/mihomo/ai.list'
    path: './rule_provider/ai.list'
  AWAvenue-Ads-Rule:
    type: http
    behavior: classical
    format: yaml
    interval: 86400
    url: 'https://github.boki.moe/https://raw.githubusercontent.com/TG-Twilight/AWAvenue-Ads-Rule/main/Filters/AWAvenue-Ads-Rule-Clash-Classical.yaml'
    path: './rule_provider/AWAvenue-Ads-Rule-Clash-Classical.yaml'

